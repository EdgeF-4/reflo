# Copy to .env and adjust for your environment. docker-compose reads these.

# Secret used to sign dashboard JWTs. Generate a long random value in production.
JWT_SECRET=change-me-in-production

# The API URL the browser bundle will call. For local Docker this is the
# host-published API port. In production set it to your public API origin.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional host-port overrides when the default loopback ports are in use.
REFLO_API_PORT=4000
REFLO_WEB_PORT=3000
