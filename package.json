{
  "name": "reflo",
  "version": "0.1.0",
  "private": true,
  "description": "Superseded runnable snapshot of a partner attribution and settlement demo.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:domain": "npm run build --workspace @reflo/domain",
    "build:widget": "npm run build --workspace @reflo/widget",
    "test": "npm run test --workspace @reflo/domain",
    "test:domain": "npm run test --workspace @reflo/domain",
    "test:dependencies": "node scripts/dependency-contract.mjs",
    "test:smoke": "bash scripts/smoke.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@nestjs/common": "11.1.29"
  }
}
